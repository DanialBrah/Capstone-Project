# Copy this file to .env and fill in your real values.
# .env is gitignored - it will never be committed.

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=course_enrolment_db
MONGODB_AUTH_DATABASE=course_enrolment_db
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Must be at least 32 characters (HMAC-SHA256 requirement). Generate your own
# for anything beyond local dev - never reuse this placeholder.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=60
